## NOVA arsenal data: ~42 original gun designs across all CODM weapon types.
## Pure data + stat helpers. Models built by GunModels, sounds by GunAudio.
##
## Model spec fields (interpreted by GunModels):
##   style  - silhouette family within the class
##   barrel - barrel length in meters
##   mag    - "curved" | "straight" | "drum" | "box" | "tube" | "stick" | "internal" | "none"
##   stock  - "fixed" | "folding" | "skeleton" | "bullpup" | "wire" | "none"
##   sight  - "iron" | "reddot" | "holo" | "scope" | "scopelong" | "none"
##   muzzle - "flash" | "suppressor" | "comp" | "brake" | "none"
##   body   - color scheme: "black" | "gunmetal" | "tan" | "od" | "grey" | "white" | "sand"
##   accent - "wood" | "tan" | "none"
##   extras - ["foregrip","bipod","laser","drum","heatshield","bayonet","carry"]

