	"ar": "Assault Rifle", "smg": "SMG", "lmg": "LMG", "sniper": "Sniper",
	"marksman": "Marksman", "shotgun": "Shotgun",
	"pistol": "Pistol", "launcher": "Launcher", "melee": "Melee",
}


static func all() -> Array:
	return _ROSTER


static func by_id(gid: String) -> Dictionary:
	for g in _ROSTER:
		if g["id"] == gid:
			return g
	return {}


static func slot_of(cls: String) -> String:
	return SLOT_OF.get(cls, "primary")


static func class_name_of(cls: String) -> String:
	return CLASS_NAMES.get(cls, cls)


static func full_name(g: Dictionary) -> String:
	return str(g["name"]) + " \"" + str(g["alias"]) + "\""


## Damage with linear falloff between range_near and range_far, min 35% past far.
static func damage_at_range(g: Dictionary, dist: float) -> float:
	var dmg: float = g["damage"]
	var rn: float = g["range_near"]
	var rf: float = g["range_far"]
	if dist <= rn:
		return dmg
	if dist >= rf:
		return dmg * 0.35
	var t: float = (dist - rn) / maxf(rf - rn, 0.01)
	return dmg * lerpf(1.0, 0.35, t)


## CODM-style headshot multipliers by class.
const HEADSHOT_MULT := {
	"sniper": 2.0, "marksman": 1.8, "ar": 1.6, "smg": 1.5, "lmg": 1.5,
	"shotgun": 1.5, "pistol": 1.5, "launcher": 1.0, "melee": 1.0,
}


static func headshot_mult(cls: String) -> float:
	return float(HEADSHOT_MULT.get(cls, 1.5))


## Shots-to-kill vs 100 HP (body) and vs 150 armor + 100 HP (armored),
## at close range, all shots landing. Shotguns assume all pellets hit.
## Returns {"body": int, "head": int, "armored_body": int, "armored_head": int}.
static func shots_to_kill(g: Dictionary) -> Dictionary:
	var cls := str(g["cls"])
	var pellets := int(g.get("pellets", 1))
	var dmg: float = float(g["damage"])
	if cls == "shotgun":
		dmg *= float(maxi(pellets, 1))
	if dmg <= 0.0:
		return {"body": 99, "head": 99, "armored_body": 99, "armored_head": 99}
	var hm := headshot_mult(cls)
	var body := int(ceil(100.0 / dmg))
	var head := int(ceil(100.0 / (dmg * hm)))
	var abody := int(ceil(250.0 / dmg))
	var ahead := int(ceil(250.0 / (dmg * hm)))
	if cls == "melee":
		# Melee is per-swing; keep raw numbers.
		pass
	return {"body": body, "head": head, "armored_body": abody, "armored_head": ahead}


## Short STK string for the HUD weapon panel, e.g. "4 SHOTS · 3 HEAD".
static func stk_label(g: Dictionary) -> String:
	var s := shots_to_kill(g)
	var cls := str(g["cls"])
	if cls == "launcher":
		return "1 BLAST KILL"
	if cls == "melee":
		return "%d SWINGS" % int(s["body"])
	return "%d SHOTS · %d HEAD" % [int(s["body"]), int(s["head"])]



## Effective stats after attachments. Returns a fresh Dictionary (numbers only).
static func effective(g: Dictionary, attach: Array) -> Dictionary:
	var e := {
		"damage": float(g["damage"]), "rpm": float(g["rpm"]),
		"range_near": float(g["range_near"]), "range_far": float(g["range_far"]),
		"mag": int(g["mag"]), "ads": float(g["ads"]), "move": float(g["move"]),
		"spread": float(g["hip_spread"]), "recv": float(g["recoil_v"]),
		"rech": float(g["recoil_h"]), "reload": float(g["reload"]),
		"silent": bool(g.get("silent", false)), "zoom": float(g.get("zoom", 0.0)),
	}
	for aid in attach:
		var m := find_attach(aid)
		if m.is_empty():
			continue
		if m.has("dmg"): e["damage"] *= float(m["dmg"])
		if m.has("rpm"): e["rpm"] *= float(m["rpm"])
		if m.has("rec"):
			e["recv"] *= float(m["rec"])
			e["rech"] *= float(m["rec"])
		if m.has("ads"): e["ads"] *= float(m["ads"])
		if m.has("magadd"): e["mag"] = maxi(1, int(e["mag"]) + int(m["magadd"]))
		if m.has("spread"): e["spread"] *= float(m["spread"])
		if m.has("range"):
			e["range_near"] *= float(m["range"])
			e["range_far"] *= float(m["range"])
		if m.has("move"): e["move"] *= float(m["move"])
		if m.has("reload"): e["reload"] *= float(m["reload"])
		if m.has("zoom"): e["zoom"] = float(m["zoom"])
		if bool(m.get("silent", false)): e["silent"] = true
	return e


static func find_attach(aid: String) -> Dictionary:
	for slot in ATTACHMENTS.keys():
		var d: Dictionary = ATTACHMENTS[slot]
		if d.has(aid):
			var m: Dictionary = (d[aid] as Dictionary).duplicate()
			m["slot"] = slot
			m["id"] = aid
			return m
	return {}


static func attach_slot(aid: String) -> String:
	var a := find_attach(aid)
	return str(a.get("slot", ""))


## Tier-weighted random gun id. Higher tier -> deadlier classes.
static func roll_gun(tier: int, rng: RandomNumberGenerator) -> String:
	var pool: Array = []
	for g in _ROSTER:
		var cls: String = g["cls"]
		var w := 1.0
		match cls:
			"pistol", "melee":
				w = 3.0 if tier <= 1 else 0.4
			"shotgun", "smg":
				w = 2.5 if tier <= 2 else 1.0
			"ar":
				w = 1.5 if tier <= 1 else 2.5
			"marksman":
				w = 0.4 if tier <= 1 else 2.0
			"lmg", "sniper":
				w = 0.3 if tier <= 2 else 2.2
			"launcher":
				w = 0.15 if tier <= 2 else 1.2
		# Launchers/melee never from plain ground tier 0.
		if tier == 0 and (cls == "launcher"):
			w = 0.0
		# RP-7 Thunderhead: high-tier menace — boosted at epic/legendary.
		if str(g["id"]) == "rp7" and tier >= 4:
			w = 2.4
		if w > 0.0:
			pool.append([g["id"], w])
	var total := 0.0
	for p in pool:
		total += float(p[1])
	var r: float = rng.randf() * total
	for p in pool:
		r -= float(p[1])
		if r <= 0.0:
			return str(p[0])
	return "m5"


## Default attachments pre-equipped by loot tier (grey->orange).
static func tier_attachments(tier: int, rng: RandomNumberGenerator) -> Array:
	var out: Array = []
	if tier >= 3:
		var cands := ["reddot", "foregrip", "extended", "compensator"]
		out.append(cands[rng.randi() % cands.size()])
	if tier >= 4:
		var c2 := ["holo", "suppressor", "laser", "extended"]
		var pick: String = c2[rng.randi() % c2.size()]
		if not out.has(pick):
			out.append(pick)
	if tier >= 5:
		if not out.has("suppressor"):
			out.append("suppressor")
	return out


